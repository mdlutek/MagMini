<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MagMini.Mobile.ViewModels"
             xmlns:dto="clr-namespace:MagMini.Application.DTOs.Orders;assembly=MagMini.Application"
             x:Class="MagMini.Mobile.Views.OrderDetailPage"
             x:DataType="vm:OrderDetailViewModel"
             Title="Szczegóły Zamówienia"
             BackgroundColor="#ECEFF4">

    <Grid RowDefinitions="Auto, *, Auto" Margin="10">

        <!-- Nagłówek dokumentu -->
        <Border Grid.Row="0" BackgroundColor="White" Stroke="#D8DEE9" StrokeShape="RoundRectangle 8" Padding="15" Margin="0,0,0,10">
            <VerticalStackLayout Spacing="4">
                <Label Text="{Binding Order.OrderNumber}" FontSize="20" FontAttributes="Bold" TextColor="#2E3440"/>
                <Label Text="{Binding Order.OrderDate, StringFormat='Data wystawienia: {0:yyyy-MM-dd}'}" FontSize="12" TextColor="#4C566A"/>
                <Label Text="{Binding Order.Remarks, StringFormat='Uwagi: {0}'}" FontSize="12" TextColor="#4C566A" IsVisible="{Binding Order.Remarks, Converter={x:Null}}"/>
            </VerticalStackLayout>
        </Border>

        <!-- Lista pozycji towarowych do skompletowania -->
        <CollectionView Grid.Row="1" ItemsSource="{Binding Items}">
            <CollectionView.Header>
                <Label Text="POZYCJE TOWAROWE (DO WYDANIA)" FontSize="12" FontAttributes="Bold" TextColor="#4C566A" Margin="5,0,0,5"/>
            </CollectionView.Header>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="dto:OrderItemDto">
                    <Border Margin="0,4" Padding="12" BackgroundColor="White" Stroke="#D8DEE9" StrokeShape="RoundRectangle 6">
                        <Grid ColumnDefinitions="*, Auto">
                            <VerticalStackLayout Grid.Column="0">
                                <Label Text="{Binding ArticleName}" FontSize="14" FontAttributes="Bold" TextColor="#2E3440"/>
                                <Label Text="{Binding ArticleCode, StringFormat='Symbol: {0}'}" FontSize="12" TextColor="#5E81AC"/>
                                <Label Text="{Binding TotalGross, StringFormat='Wartość: {0:N2} zł'}" FontSize="12" TextColor="#4C566A"/>
                            </VerticalStackLayout>

                            <!-- Ilość do wydania -->
                            <Label Grid.Column="1" Text="{Binding Quantity, StringFormat='{0:N0} szt.'}" FontSize="16" FontAttributes="Bold" TextColor="#2E3440" VerticalOptions="Center"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Dolny panel z podsumowaniem i przyciskiem Realizacji / Informacją o statusie -->
        <Border Grid.Row="2" BackgroundColor="#2E3440" StrokeShape="RoundRectangle 8" Padding="15" Margin="0,10,0,0">
            <VerticalStackLayout Spacing="10">
                <Grid ColumnDefinitions="*, Auto">
                    <Label Text="ŁĄCZNIE BRUTTO:" TextColor="White" FontAttributes="Bold" FontSize="14" VerticalOptions="Center"/>
                    <Label Grid.Column="1" Text="{Binding Order.TotalGross, StringFormat='{0:N2} zł'}" TextColor="#88C0D0" FontAttributes="Bold" FontSize="18"/>
                </Grid>

                <!-- Przycisk widoczny TYLKO, gdy zamówienie czeka na realizację -->
                <Button Text="✅ REALIZUJ (WYDAJ TOWAR)" Command="{Binding CompleteOrderCommand}" 
                        IsVisible="{Binding CanComplete}"
                        BackgroundColor="#A3BE8C" TextColor="#2E3440" FontAttributes="Bold" HeightRequest="48" CornerRadius="6"/>

                <!-- Baner informacyjny gdy zamówienie jest już zrealizowane -->
                <Border IsVisible="{Binding CanComplete, Converter={x:Null}}" 
                        BackgroundColor="#3B4252" StrokeShape="RoundRectangle 6" Padding="10">
                    <Label Text="🔒 DOKUMENT ZREALIZOWANY (TOWAR WYDANY)" 
                           TextColor="#A3BE8C" FontAttributes="Bold" HorizontalOptions="Center"/>
                </Border>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>