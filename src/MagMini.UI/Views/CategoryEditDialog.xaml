<Window x:Class="MagMini.UI.Views.CategoryEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}" Height="360" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#ECEFF4" FontFamily="Segoe UI">
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding WindowTitle}" FontSize="20" FontWeight="Bold" Foreground="#2E3440" Margin="0,0,0,15"/>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Symbol (Kod unikalny)*:" FontWeight="SemiBold"/>
            <TextBox Text="{Binding Category.Code, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,0,0,10"/>

            <TextBlock Text="Nazwa kategorii*:" FontWeight="SemiBold"/>
            <TextBox Text="{Binding Category.Name, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,0,0,10"/>

            <TextBlock Text="Opis:" FontWeight="SemiBold"/>
            <TextBox Text="{Binding Category.Description, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,0,0,10"/>

            <TextBlock Text="{Binding ErrorMessage}" Foreground="#BF616A" FontWeight="Bold"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Anuluj" IsCancel="True" Width="85" Height="32" Margin="0,0,10,0" Background="#E5E9F0"/>
            <Button Content="Zapisz" Command="{Binding SaveCommand}" Width="95" Height="32" Background="#5E81AC" Foreground="White" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>