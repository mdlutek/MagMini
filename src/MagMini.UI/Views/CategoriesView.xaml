<UserControl x:Class="MagMini.UI.Views.CategoriesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#ECEFF4" FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Wyszukiwarka -->
        <Border Grid.Row="0" Background="White" CornerRadius="6" Padding="15,10" Margin="0,0,0,12" BorderBrush="#D8DEE9" BorderThickness="1">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="Szukaj (Symbol / Nazwa):" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0" Foreground="#4C566A"/>
                    <TextBox Text="{Binding SearchPhrase, UpdateSourceTrigger=PropertyChanged}" Width="250" Height="30" Padding="5,2" VerticalContentAlignment="Center"/>
                    <Button Content="🔍 Szukaj" Command="{Binding SearchCommand}" Height="30" Width="90" Margin="12,0,0,0" Background="#5E81AC" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <TextBlock Text="Słownik Kategorii Towarowych" FontSize="16" FontWeight="Bold" Foreground="#2E3440" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- DataGrid Kategorii -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  Background="White" RowHeaderWidth="0" GridLinesVisibility="Horizontal"
                  BorderBrush="#D8DEE9" BorderThickness="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Symbol" Binding="{Binding Code}" Width="140" FontWeight="Bold"/>
                <DataGridTextColumn Header="Nazwa kategorii" Binding="{Binding Name}" Width="250" FontWeight="SemiBold"/>
                <DataGridTextColumn Header="Opis" Binding="{Binding Description}" Width="*"/>
                <DataGridTextColumn Header="Przypisanych artykułów" Binding="{Binding ArticlesCount}" Width="180" FontWeight="Bold"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Przyciski -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="➕ Dodaj kategorię" Command="{Binding AddCategoryCommand}" Height="34" Width="140" Background="#A3BE8C" Foreground="#2E3440" FontWeight="Bold" BorderThickness="0" Margin="0,0,8,0"/>
            <Button Content="✏️ Edytuj" Command="{Binding EditCategoryCommand}" Height="34" Width="100" Background="#88C0D0" Foreground="#2E3440" FontWeight="Bold" BorderThickness="0" Margin="0,0,8,0"/>
            <Button Content="🗑️ Usuń" Command="{Binding DeleteCategoryCommand}" Height="34" Width="100" Background="#BF616A" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</UserControl>