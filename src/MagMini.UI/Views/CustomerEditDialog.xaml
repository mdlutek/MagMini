<Window x:Class="MagMini.UI.Views.CustomerEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}" Height="590" Width="540"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#ECEFF4" FontFamily="Segoe UI">
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding WindowTitle}" FontSize="20" FontWeight="Bold" Foreground="#2E3440" Margin="0,0,0,15"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <CheckBox Content="Kontrahent jest firmą (wymaga NIP)" IsChecked="{Binding Customer.IsCompany}" FontWeight="SemiBold" Margin="0,0,0,12"/>

                <!-- Wiersz NIP z przyciskiem pobierania z GUS -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                        <TextBlock Text="NIP (dla firm):" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding Customer.Nip, UpdateSourceTrigger=PropertyChanged}" Height="30" IsEnabled="{Binding Customer.IsCompany}"/>
                    </StackPanel>

                    <Button Grid.Column="1" Content="🔍 Pobierz z GUS / MF" Command="{Binding FetchFromGusCommand}"
                            IsEnabled="{Binding Customer.IsCompany}"
                            Height="30" Padding="12,0" Margin="5,16,0,0"
                            Background="#88C0D0" Foreground="#2E3440" FontWeight="Bold" BorderThickness="0"/>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Symbol (Kod unikalny)*:" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding Customer.Code, UpdateSourceTrigger=PropertyChanged}" Height="30"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Pełna nazwa kontrahenta*:" FontWeight="SemiBold"/>
                <TextBox Text="{Binding Customer.Name, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,0,0,10"/>

                <TextBlock Text="Ulica i numer:" FontWeight="SemiBold"/>
                <TextBox Text="{Binding Customer.Street, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                        <TextBlock Text="Kod pocztowy:" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding Customer.PostalCode, UpdateSourceTrigger=PropertyChanged}" Height="30"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="5,0,0,0">
                        <TextBlock Text="Miejscowość:" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding Customer.City, UpdateSourceTrigger=PropertyChanged}" Height="30"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                        <TextBlock Text="Telefon:" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding Customer.Phone, UpdateSourceTrigger=PropertyChanged}" Height="30"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="5,0,0,0">
                        <TextBlock Text="Adres E-mail:" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding Customer.Email, UpdateSourceTrigger=PropertyChanged}" Height="30"/>
                    </StackPanel>
                </Grid>

                <!-- Komunikaty sukcesu i błędu -->
                <TextBlock Text="{Binding SuccessInfo}" Foreground="#A3BE8C" FontWeight="Bold" Margin="0,5,0,0"/>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#BF616A" FontWeight="Bold" Margin="0,5,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Przyciski akcji -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Anuluj" IsCancel="True" Width="85" Height="32" Margin="0,0,10,0" Background="#E5E9F0"/>
            <Button Content="Zapisz" Command="{Binding SaveCommand}" Width="95" Height="32" Background="#5E81AC" Foreground="White" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>