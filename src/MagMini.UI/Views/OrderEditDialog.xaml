<Window x:Class="MagMini.UI.Views.OrderEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}" Height="680" Width="950"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="#ECEFF4" FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 1. Nagłówek dokumentu -->
            <RowDefinition Height="Auto"/>
            <!-- 2. Dodawanie pozycji -->
            <RowDefinition Height="*"/>
            <!-- 3. Tabela pozycji -->
            <RowDefinition Height="Auto"/>
            <!-- 4. Podsumowanie kwot i Przyciski -->
        </Grid.RowDefinitions>

        <!-- 1. NAGŁÓWEK DOKUMENTU -->
        <Border Grid.Row="0" Background="White" CornerRadius="6" Padding="15" Margin="0,0,0,12" BorderBrush="#D8DEE9" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Numer dokumentu:" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding Order.OrderNumber, UpdateSourceTrigger=PropertyChanged}" Height="30" FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="Data wystawienia:" FontWeight="SemiBold"/>
                    <DatePicker SelectedDate="{Binding Order.OrderDate}" Height="30"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                    <TextBlock Text="Kontrahent (Odbiorca)*:" FontWeight="SemiBold"/>
                    <ComboBox ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}" DisplayMemberPath="Name" Height="30"/>
                </StackPanel>

                <StackPanel Grid.Column="3">
                    <TextBlock Text="Uwagi do zamówienia:" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding Order.Remarks, UpdateSourceTrigger=PropertyChanged}" Height="30"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. DODAWANIE POZYCJI -->
        <Border Grid.Row="1" Background="White" CornerRadius="6" Padding="12" Margin="0,0,0,10" BorderBrush="#D8DEE9" BorderThickness="1">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="Wybierz towar:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>

                    <!-- Poprawiony ComboBox z ładnym szablonem -->
                    <ComboBox ItemsSource="{Binding Articles}" SelectedItem="{Binding SelectedArticleToAdd}" Width="380" Height="30">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="[" FontWeight="Bold" Foreground="#5E81AC"/>
                                    <TextBlock Text="{Binding Code}" FontWeight="Bold" Foreground="#5E81AC"/>
                                    <TextBlock Text="] " FontWeight="Bold" Foreground="#5E81AC"/>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    <TextBlock Text=" - " Foreground="#4C566A"/>
                                    <TextBlock Text="{Binding DefaultSalePriceNet, StringFormat={}{0:N2} zł}" Foreground="#4C566A"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="Ilość:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="15,0,8,0"/>
                    <TextBox Text="{Binding QuantityToAdd, UpdateSourceTrigger=PropertyChanged}" Width="70" Height="30" VerticalContentAlignment="Center" FontWeight="Bold"/>

                    <Button Content="➕ Dodaj pozycję" Command="{Binding AddItemCommand}" Height="30" Width="120" Margin="15,0,0,0" Background="#A3BE8C" Foreground="#2E3440" FontWeight="Bold" BorderThickness="0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="❌ Usuń zaznaczoną" Command="{Binding RemoveItemCommand}" Height="30" Width="130" Background="#BF616A" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 3. TABELA POZYCJI -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                  AutoGenerateColumns="False" IsReadOnly="False" SelectionMode="Single"
                  Background="White" RowHeaderWidth="0" GridLinesVisibility="Horizontal"
                  BorderBrush="#D8DEE9" BorderThickness="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Symbol" Binding="{Binding ArticleCode}" Width="110" IsReadOnly="True" FontWeight="Bold"/>
                <DataGridTextColumn Header="Nazwa artykułu" Binding="{Binding ArticleName}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Ilość" Binding="{Binding Quantity, StringFormat={}{0:N2}}" Width="90" FontWeight="Bold"/>
                <DataGridTextColumn Header="Cena Netto" Binding="{Binding UnitPriceNet, StringFormat={}{0:N2} zł}" Width="120"/>
                <DataGridTextColumn Header="VAT" Binding="{Binding VatRate}" Width="70" IsReadOnly="True"/>
                <DataGridTextColumn Header="Wartość Netto" Binding="{Binding TotalNet, StringFormat={}{0:N2} zł}" Width="120" IsReadOnly="True"/>
                <DataGridTextColumn Header="Wartość Brutto" Binding="{Binding TotalGross, StringFormat={}{0:N2} zł}" Width="130" IsReadOnly="True" FontWeight="Bold"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 4. PODSUMOWANIE DOKUMENTU I PRZYCISKI -->
        <Grid Grid.Row="3" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Błąd i Przyciski -->
            <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#BF616A" FontWeight="Bold" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Anuluj" IsCancel="True" Width="90" Height="34" Margin="0,0,10,0" Background="#E5E9F0"/>
                    <Button Content="💾 Zapisz zamówienie" Command="{Binding SaveCommand}" Width="160" Height="34" Background="#5E81AC" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
                </StackPanel>
            </StackPanel>

            <!-- Podsumowanie finansowe ERP (Netto, VAT, Brutto) -->
            <Border Grid.Column="1" Background="#ECEFF4" BorderBrush="#D8DEE9" BorderThickness="1" CornerRadius="6" Padding="15,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="130"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Razem Netto:" FontWeight="SemiBold" Foreground="#4C566A"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TotalNet, StringFormat={}{0:N2} zł}" HorizontalAlignment="Right" FontWeight="SemiBold"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Kwota VAT:" FontWeight="SemiBold" Foreground="#4C566A" Margin="0,4,0,0"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TotalVat, StringFormat={}{0:N2} zł}" HorizontalAlignment="Right" FontWeight="SemiBold" Margin="0,4,0,0"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="RAZEM BRUTTO:" FontSize="14" FontWeight="Bold" Foreground="#2E3440" Margin="0,8,0,0"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TotalGross, StringFormat={}{0:N2} zł}" FontSize="15" FontWeight="Bold" Foreground="#2E3440" HorizontalAlignment="Right" Margin="0,8,0,0"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>