<UserControl x:Class="MagMini.UI.Views.ArticlesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#ECEFF4" FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 1. Pasek wyszukiwania i filtrów -->
            <RowDefinition Height="*"/>
            <!-- 2. DataGrid towarów -->
            <RowDefinition Height="Auto"/>
            <!-- 3. Paginator + Przyciski akcji -->
        </Grid.RowDefinitions>

        <!-- 1. PASEK FILTRÓW (GÓRA) -->
        <Border Grid.Row="0" Background="White" CornerRadius="6" Padding="15,10" Margin="0,0,0,12" BorderBrush="#D8DEE9" BorderThickness="1">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <!-- Szukaj po frazie -->
                    <TextBlock Text="Szukaj (Symbol / Nazwa / EAN):" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0" Foreground="#4C566A"/>
                    <TextBox Text="{Binding SearchPhrase, UpdateSourceTrigger=PropertyChanged}" Width="250" Height="30" Padding="5,2" VerticalContentAlignment="Center"/>

                    <!-- Filtr kategorii -->
                    <TextBlock Text="Kategoria:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="15,0,8,0" Foreground="#4C566A"/>
                    <ComboBox ItemsSource="{Binding Categories}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedCategory}" Width="190" Height="30"/>

                    <!-- Przycisk Filtruj -->
                    <Button Content="🔍 Filtruj" Command="{Binding SearchCommand}" Height="30" Width="90" Margin="12,0,0,0" Background="#5E81AC" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <TextBlock Text="Kartoteka Towarów i Usług" FontSize="16" FontWeight="Bold" Foreground="#2E3440" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 2. DATAGRID TOWARÓW (ŚRODEK) -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding Articles}" SelectedItem="{Binding SelectedArticle}"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  Background="White" RowHeaderWidth="0" GridLinesVisibility="Horizontal"
                  BorderBrush="#D8DEE9" BorderThickness="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Symbol" Binding="{Binding Code}" Width="120" FontWeight="Bold"/>
                <DataGridTextColumn Header="Nazwa artykułu" Binding="{Binding Name}" Width="*" MinWidth="200"/>
                <DataGridTextColumn Header="Kategoria" Binding="{Binding CategoryName}" Width="140"/>
                <DataGridTextColumn Header="EAN" Binding="{Binding Ean}" Width="120"/>
                <DataGridTextColumn Header="J.m." Binding="{Binding Unit}" Width="60"/>
                <DataGridTextColumn Header="Cena Zakupu Netto" Binding="{Binding PurchasePriceNet, StringFormat={}{0:N2} zł}" Width="130"/>
                <DataGridTextColumn Header="Cena Sprzedaży Netto" Binding="{Binding DefaultSalePriceNet, StringFormat={}{0:N2} zł}" Width="140"/>
                <DataGridTextColumn Header="Cena Brutto" Binding="{Binding DefaultSalePriceGross, StringFormat={}{0:N2} zł}" Width="120" FontWeight="SemiBold"/>
                <DataGridTextColumn Header="Stan magazynowy" Binding="{Binding StockQuantity, StringFormat={}{0:N2}}" Width="120" FontWeight="Bold"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 3. DOLNY PASEK: PAGINACJA + PRZYCISKI AKCJI (DÓŁ) -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Przyciski ERP: Dodaj, Edytuj, Usuń -->
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Content="➕ Dodaj towar" Command="{Binding AddArticleCommand}" Height="34" Width="120" Background="#A3BE8C" Foreground="#2E3440" FontWeight="Bold" BorderThickness="0" Margin="0,0,8,0"/>
                <Button Content="✏️ Edytuj" Command="{Binding EditArticleCommand}" Height="34" Width="100" Background="#88C0D0" Foreground="#2E3440" FontWeight="Bold" BorderThickness="0" Margin="0,0,8,0"/>
                <Button Content="🗑️ Usuń" Command="{Binding DeleteArticleCommand}" Height="34" Width="100" Background="#BF616A" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
            </StackPanel>

            <!-- Kontrolki Paginacji (Server-side) -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding TotalCount, StringFormat=Łącznie artykułów: {0}}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#4C566A" Margin="0,0,15,0"/>

                <Button Content="◀ Poprzednia" Command="{Binding PrevPageCommand}" Height="30" Width="95" Background="#E5E9F0" BorderBrush="#D8DEE9"/>

                <TextBlock VerticalAlignment="Center" Margin="10,0" FontWeight="Bold" Foreground="#2E3440">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="Strona {0} z {1}">
                            <Binding Path="PageNumber"/>
                            <Binding Path="TotalPages"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>

                <Button Content="Następna ▶" Command="{Binding NextPageCommand}" Height="30" Width="95" Background="#E5E9F0" BorderBrush="#D8DEE9"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>