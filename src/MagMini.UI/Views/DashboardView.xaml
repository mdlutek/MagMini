<UserControl x:Class="MagMini.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8F9FA">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Nagłówek -->
        <StackPanel Grid.Row="0" Margin="0,0,0,30">
            <TextBlock Text="Pulpit Główny" FontSize="28" FontWeight="Bold" Foreground="#2E3440"/>
            <TextBlock Text="Podsumowanie stanu systemu i kluczowe wskaźniki" FontSize="14" Foreground="#4C566A" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Kafelki podsumowania -->
        <WrapPanel Grid.Row="1" Orientation="Horizontal">
            <!-- Kafelek Artykuły -->
            <Border Background="White" CornerRadius="8" Width="220" Height="120" Margin="0,0,20,20" BorderBrush="#E5E9F0" BorderThickness="1">
                <StackPanel Margin="20">
                    <TextBlock Text="ARTYKUŁY" FontSize="12" FontWeight="Bold" Foreground="#88C0D0"/>
                    <TextBlock Text="{Binding ArticlesCount}" FontSize="32" FontWeight="Bold" Foreground="#2E3440" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- Kafelek Kontrahenci -->
            <Border Background="White" CornerRadius="8" Width="220" Height="120" Margin="0,0,20,20" BorderBrush="#E5E9F0" BorderThickness="1">
                <StackPanel Margin="20">
                    <TextBlock Text="KONTRAHENCI" FontSize="12" FontWeight="Bold" Foreground="#A3BE8C"/>
                    <TextBlock Text="{Binding CustomersCount}" FontSize="32" FontWeight="Bold" Foreground="#2E3440" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- Kafelek Zamówienia -->
            <Border Background="White" CornerRadius="8" Width="220" Height="120" Margin="0,0,20,20" BorderBrush="#E5E9F0" BorderThickness="1">
                <StackPanel Margin="20">
                    <TextBlock Text="ZAMÓWIENIA" FontSize="12" FontWeight="Bold" Foreground="#EBCB8B"/>
                    <TextBlock Text="{Binding OrdersCount}" FontSize="32" FontWeight="Bold" Foreground="#2E3440" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- Kafelek Sprzedaż Łączna -->
            <Border Background="White" CornerRadius="8" Width="260" Height="120" Margin="0,0,20,20" BorderBrush="#E5E9F0" BorderThickness="1">
                <StackPanel Margin="20">
                    <TextBlock Text="WARTOŚĆ ZAMÓWIEŃ (BRUTTO)" FontSize="12" FontWeight="Bold" Foreground="#B48EAD"/>
                    <TextBlock Text="{Binding TotalSalesGross, StringFormat={}{0:N2} zł}" FontSize="28" FontWeight="Bold" Foreground="#2E3440" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </WrapPanel>
    </Grid>
</UserControl>