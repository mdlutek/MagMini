<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MagMini.Mobile.ViewModels"
             x:Class="MagMini.Mobile.Views.ScannerPage"
             x:DataType="vm:ScannerViewModel"
             Title="Skaner Magazynowy"
             BackgroundColor="#1E1E2E">

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="15">

            <!-- Celownik laserowy (Wizualizacja skanera) -->
            <Border BackgroundColor="#2E3440" Stroke="#5E81AC" StrokeThickness="2" StrokeShape="RoundRectangle 12" HeightRequest="140">
                <Grid VerticalOptions="Center" HorizontalOptions="Center">
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Label Text="📷" FontSize="40" HorizontalOptions="Center"/>
                        <Label Text="SKANER LASEROWY / APARAT" FontSize="12" FontAttributes="Bold" TextColor="#88C0D0" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Wprowadzanie kodu (Ręczne / Kolektor danych Zebra / Emulator) -->
            <Label Text="Wprowadź lub zeskanuj kod (EAN / Symbol):" TextColor="#D8DEE9" FontSize="13" FontAttributes="Bold"/>
            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                <Border Grid.Column="0" BackgroundColor="#2E3440" Stroke="#3B4252" StrokeShape="RoundRectangle 8" Padding="10,0">
                    <Entry Text="{Binding BarcodeInput}" Placeholder="Wpisz np. 111111111..." 
                           TextColor="White" PlaceholderColor="#4C566A" HeightRequest="45"
                           ReturnCommand="{Binding SearchBarcodeCommand}"/>
                </Border>
                <Button Grid.Column="1" Text="🔍 SZUKAJ" Command="{Binding SearchBarcodeCommand}" 
                        BackgroundColor="#5E81AC" TextColor="White" FontAttributes="Bold" HeightRequest="45" CornerRadius="8"/>
            </Grid>

            <!-- Status wyszukiwania -->
            <Label Text="{Binding StatusMessage}" TextColor="#EBCB8B" FontAttributes="Bold" HorizontalOptions="Center"/>
            <ActivityIndicator IsRunning="{Binding IsSearching}" Color="#88C0D0" HorizontalOptions="Center"/>

            <!-- KARTA ZNALEZIONEGO TOWARU (WYNIK SKANOWANIA) -->
            <Border IsVisible="{Binding ScannedArticle, Converter={x:Null}}"
                    BackgroundColor="White" Stroke="#A3BE8C" StrokeThickness="2" StrokeShape="RoundRectangle 12" Padding="20" Margin="0,10,0,0">
                <VerticalStackLayout Spacing="12">
                    <Label Text="WYNIK WERYFIKACJI TOWARU" FontSize="11" FontAttributes="Bold" TextColor="#4C566A"/>

                    <Label Text="{Binding ScannedArticle.Name}" FontSize="20" FontAttributes="Bold" TextColor="#2E3440"/>

                    <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" RowSpacing="8">
                        <Label Grid.Row="0" Grid.Column="0" Text="{Binding ScannedArticle.Code, StringFormat='Symbol: {0}'}" FontSize="13" FontAttributes="Bold" TextColor="#5E81AC"/>
                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding ScannedArticle.CategoryName, StringFormat='Kategoria: {0}'}" FontSize="13" TextColor="#4C566A"/>

                        <Label Grid.Row="1" Grid.Column="0" Text="{Binding ScannedArticle.Ean, StringFormat='EAN: {0}'}" FontSize="12" TextColor="#4C566A"/>
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding ScannedArticle.DefaultSalePriceGross, StringFormat='Cena: {0:N2} zł'}" FontSize="15" FontAttributes="Bold" TextColor="#2E3440"/>
                    </Grid>

                    <!-- Duży licznik stanu magazynowego -->
                    <Border BackgroundColor="#ECEFF4" Stroke="#D8DEE9" StrokeShape="RoundRectangle 8" Padding="15" Margin="0,5,0,0">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="STAN MAGAZYNOWY:" FontSize="13" FontAttributes="Bold" TextColor="#2E3440" VerticalOptions="Center"/>
                            <Label Grid.Column="1" Text="{Binding ScannedArticle.StockQuantity, StringFormat='{0:N0} szt.'}" FontSize="24" FontAttributes="Bold" TextColor="#A3BE8C"/>
                        </Grid>
                    </Border>

                    <Button Text="Wyczyść wynik" Command="{Binding ClearCommand}" 
                            BackgroundColor="#E5E9F0" TextColor="#2E3440" HeightRequest="38" CornerRadius="6" Margin="0,5,0,0"/>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>