<Window x:Class="MagMini.UI.Views.ArticleEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}" Height="540" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#ECEFF4" FontFamily="Segoe UI">
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding WindowTitle}" FontSize="20" FontWeight="Bold" Foreground="#2E3440" Margin="0,0,0,15"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                        <TextBlock Text="Symbol (SKU)*:" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding Article.Code, UpdateSourceTrigger=PropertyChanged}" Height="30"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="5,0,0,0">
                        <TextBlock Text="Kod kreskowy EAN:" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding Article.Ean, UpdateSourceTrigger=PropertyChanged}" Height="30"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Nazwa towaru/usługi*:" FontWeight="SemiBold" Margin="0,5,0,0"/>
                <TextBox Text="{Binding Article.Name, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,0,0,10"/>

                <TextBlock Text="Kategoria:" FontWeight="SemiBold"/>
                <ComboBox ItemsSource="{Binding Categories}" DisplayMemberPath="Name" SelectedValuePath="Id"
                          SelectedValue="{Binding Article.CategoryId}" Height="30" Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                        <TextBlock Text="Jednostka miary:" FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding Units}" SelectedItem="{Binding Article.Unit}" Height="30"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="5,0,0,0">
                        <TextBlock Text="Stawka VAT:" FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding VatRates}" SelectedItem="{Binding Article.VatRate}" Height="30"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                        <TextBlock Text="Cena zakupu Netto (zł):" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding Article.PurchasePriceNet, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}" Height="30"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="5,0,0,0">
                        <TextBlock Text="Cena sprzedaży Netto (zł):" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding Article.DefaultSalePriceNet, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}" Height="30"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                        <TextBlock Text="Stan magazynowy:" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding Article.StockQuantity, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N4}}" Height="30"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="5,0,0,0">
                        <TextBlock Text="Stan minimalny (alarm):" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding Article.MinStockQuantity, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N4}}" Height="30"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="{Binding ErrorMessage}" Foreground="#BF616A" FontWeight="Bold" Margin="0,5,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Przyciski akcji -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Anuluj" IsCancel="True" Width="85" Height="32" Margin="0,0,10,0" Background="#E5E9F0"/>
            <Button Content="Zapisz" Command="{Binding SaveCommand}" Width="95" Height="32" Background="#5E81AC" Foreground="White" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>