<UserControl x:Class="MagMini.UI.Views.CustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#ECEFF4" FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Pasek Wyszukiwania -->
        <Border Grid.Row="0" Background="White" CornerRadius="6" Padding="15,10" Margin="0,0,0,12" BorderBrush="#D8DEE9" BorderThickness="1">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="Szukaj (Symbol / Nazwa / NIP / Miasto):" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0" Foreground="#4C566A"/>
                    <TextBox Text="{Binding SearchPhrase, UpdateSourceTrigger=PropertyChanged}" Width="280" Height="30" Padding="5,2" VerticalContentAlignment="Center"/>
                    <Button Content="🔍 Szukaj" Command="{Binding SearchCommand}" Height="30" Width="90" Margin="12,0,0,0" Background="#5E81AC" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <TextBlock Text="Kartoteka Kontrahentów" FontSize="16" FontWeight="Bold" Foreground="#2E3440" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- DataGrid Kontrahentów -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  Background="White" RowHeaderWidth="0" GridLinesVisibility="Horizontal"
                  BorderBrush="#D8DEE9" BorderThickness="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Symbol" Binding="{Binding Code}" Width="120" FontWeight="Bold"/>
                <DataGridTextColumn Header="Nazwa kontrahenta" Binding="{Binding Name}" Width="*" MinWidth="220"/>
                <DataGridTextColumn Header="NIP" Binding="{Binding Nip}" Width="120"/>
                <DataGridTextColumn Header="Typ" Binding="{Binding TypeDescription}" Width="110"/>
                <DataGridTextColumn Header="Miejscowość" Binding="{Binding City}" Width="140"/>
                <DataGridTextColumn Header="Ulica" Binding="{Binding Street}" Width="160"/>
                <DataGridTextColumn Header="Telefon" Binding="{Binding Phone}" Width="120"/>
                <DataGridTextColumn Header="E-mail" Binding="{Binding Email}" Width="160"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Paginacja i Przyciski -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Content="➕ Dodaj kontrahenta" Command="{Binding AddCustomerCommand}" Height="34" Width="140" Background="#A3BE8C" Foreground="#2E3440" FontWeight="Bold" BorderThickness="0" Margin="0,0,8,0"/>
                <Button Content="✏️ Edytuj" Command="{Binding EditCustomerCommand}" Height="34" Width="100" Background="#88C0D0" Foreground="#2E3440" FontWeight="Bold" BorderThickness="0" Margin="0,0,8,0"/>
                <Button Content="🗑️ Usuń" Command="{Binding DeleteCustomerCommand}" Height="34" Width="100" Background="#BF616A" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding TotalCount, StringFormat=Łącznie kontrahentów: {0}}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#4C566A" Margin="0,0,15,0"/>
                <Button Content="◀ Poprzednia" Command="{Binding PrevPageCommand}" Height="30" Width="95" Background="#E5E9F0" BorderBrush="#D8DEE9"/>
                <TextBlock VerticalAlignment="Center" Margin="10,0" FontWeight="Bold" Foreground="#2E3440">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="Strona {0} z {1}">
                            <Binding Path="PageNumber"/>
                            <Binding Path="TotalPages"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
                <Button Content="Następna ▶" Command="{Binding NextPageCommand}" Height="30" Width="95" Background="#E5E9F0" BorderBrush="#D8DEE9"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>